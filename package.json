{
	"name": "pi-agent-extensions",
	"version": "2.30.0",
	"description": "Extensions for the pi coding agent",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build:workflow": "node scripts/sync-durable-workflow-runtime.mjs",
		"build:history-worker": "node scripts/sync-history-worker.mjs",
		"check": "npm run lint && npm run typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsgo --config tsconfig.json",
		"test": "bun test",
		"test:structured-output-host": "node scripts/test-structured-output-host.mjs",
		"test:pi-1": "node scripts/test-pi-1-catalog.mjs",
		"test:selection-rpc": "node scripts/test-selection-rpc.mjs",
		"test:selection-tool": "node scripts/test-selection-tool.mjs",
		"tools:list": "node scripts/list-tools.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@rslint/tsgo": "^0.4.2",
		"@types/node": "^22.0.0",
		"typebox": "^1.1.24",
		"typescript": "^5.7.0"
	},
	"dependencies": {
		"@byteowlz/oqto-openui": "file:vendor/oqto-openui/byteowlz-oqto-openui-0.2.1.tgz",
		"@openuidev/lang-core": "1.0.2"
	}
}
