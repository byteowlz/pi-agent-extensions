{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OqtoTodosConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "debug": {
      "type": "boolean",
      "default": false
    },
    "storagePath": {
      "type": "string"
    },
    "sessionScoped": {
      "type": "boolean",
      "default": true
    },
    "tuiWidget": {
      "type": "boolean",
      "default": true
    },
    "tuiWidgetCollapsed": {
      "type": "boolean",
      "default": true
    },
    "preserveInCompaction": {
      "type": "boolean",
      "default": true
    },
    "maxContentLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4000,
      "default": 160,
      "description": "Maximum characters per todo. Longer content is truncated with an ellipsis on write and render. 0 disables the cap."
    }
  }
}
